{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "test": false,
      "codeclot": false
    }
  },
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi'"
}
